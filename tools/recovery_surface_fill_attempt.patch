+// ----- Surface fill (anaglyph recovery) ------------------------------------
+// Inside a plain surface -- red paint, a wall -- there is nothing to match:
+// one view's channel is blank there, and every candidate is a guess. The
+// surface's OUTLINE shows in both views, though, and matches well. So (after
+// SIRA's "one disparity per segment"): pixels whose own match is trustworthy
+// are anchors -- structure on both sides of the match, the two eyes agreeing,
+// a unique winner -- and every other pixel takes its disparity from the
+// nearest anchor, "nearest" counting the colour change crossed on the way
+// (a geodesic distance). A plain surface is reached from its own outline,
+// never across an edge into another object. Jump flooding: strides 32..1
+// texels, 9 neighbours each, so a large surface fills in six passes.
+// State: .x/.y disparity (left/right eye), .z/.w each one's cost (distance).
+
+float surfStructure(float2 uv, float tx, bool rightView)
+{
+    const float3 a = srcTex.SampleLevel(samp, uv - float2(tx, 0), 0).rgb, b = srcTex.SampleLevel(samp, uv + float2(tx, 0), 0).rgb;
+    const float3 c = srcTex.SampleLevel(samp, uv - float2(0, tx), 0).rgb, d = srcTex.SampleLevel(samp, uv + float2(0, tx), 0).rgb;
+    return rightView ? abs(anaChanR(a) - anaChanR(b)) + abs(anaChanR(c) - anaChanR(d))
+                     : abs(anaChanL(a) - anaChanL(b)) + abs(anaChanL(c) - anaChanL(d));
+}
+// dispTex: the smoothed disparity (.rg) and confidence (.ba); srcTex: 1/4 anaglyph.
+float4 PSSurfInit(VSOut i) : SV_Target
+{
+    const float2 uv = i.uv;
+    const float tx = 1.0 / max(g_coarseW, 1.0);
+    const float4 d = dispTex.SampleLevel(samp, uv, 0.0);
+    // Evidence per eye: structure here in this eye's channel AND at the
+    // matched spot in the other's, times the match's own confidence.
+    const float eL = saturate(surfStructure(uv, tx, false) / 0.03) * saturate(surfStructure(uv + float2(d.r, 0), tx, true) / 0.03) * d.b;
+    const float eR = saturate(surfStructure(uv, tx, true) / 0.03) * saturate(surfStructure(uv + float2(d.g, 0), tx, false) / 0.03) * d.a;
+    return float4(d.rg, (1.0 - eL) * 1.0, (1.0 - eR) * 1.0);
+}
+// One jump pass, stride g_propStride texels. dispTex: the state.
+float4 PSSurfJump(VSOut i) : SV_Target
+{
+    const float2 uv = i.uv;
+    const float2 t = float2(1.0 / max(g_coarseW, 1.0), 1.0 / max(g_coarseH, 1.0));
+    const float s = g_propStride;
+    const float3 c0 = srcTex.SampleLevel(samp, uv, 0).rgb;
+    float4 best = dispTex.SampleLevel(samp, uv, 0.0);
+    [unroll] for (int k = 0; k < 9; ++k)
+    {
+        if (k == 4) continue;
+        const float2 o = float2(k % 3 - 1, k / 3 - 1) * s;
+        const float2 q = uv + o * t;
+        if (any(q < 0.0) || any(q > 1.0)) continue;
+        const float4 n = dispTex.SampleLevel(samp, q, 0.0);
+        // (Point-to-point colour change stands in for the path's: at the big
+        // strides it can hop over a thin line of another colour, but the
+        // small strides after it pull back to local anchors.)
+        const float3 cq = srcTex.SampleLevel(samp, q, 0).rgb;
+        const float step = dot(abs(cq - c0), float3(1, 1, 1)) * 6.0 + length(o) * 0.005;
+        if (n.z + step < best.z) { best.x = n.x; best.z = n.z + step; }
+        if (n.w + step < best.w) { best.y = n.y; best.w = n.w + step; }
+    }
+    return best;
+}
+// The result: the filled disparities, the original confidence. dispTex: the
+// state; srcPrevQ... (t8 unused). The confidence comes from t7 (the smoothed map).
+float4 PSSurfOut(VSOut i) : SV_Target
+{
+    // Only a pixel whose own match couldn't be checked takes the filled
+    // disparity; any match with structure behind it keeps its own (the fill
+    // is for the plain insides of surfaces, not a second opinion on edges).
+    const float2 uv = i.uv;
+    const float tx = 1.0 / max(g_coarseW, 1.0);
+    const float4 s = dispTex.SampleLevel(samp, uv, 0.0);
+    const float4 o = dispPrevTex.SampleLevel(samp, uv, 0.0);
+    const float vL = saturate(surfStructure(uv, tx, false) / 0.03) * saturate(surfStructure(uv + float2(o.r, 0), tx, true) / 0.03);
+    const float vR = saturate(surfStructure(uv, tx, true) / 0.03) * saturate(surfStructure(uv + float2(o.g, 0), tx, false) / 0.03);
+    return float4(vL >= 0.1 ? o.r : s.x, vR >= 0.1 ? o.g : s.y, o.ba);
+}
