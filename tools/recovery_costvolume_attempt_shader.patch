+        const int ax = a % 9 - 4, ay = a / 9 - 4;
+        const int2 q = clamp(p + int2(ax, ay) * 2, int2(0, 0), int2(W - 1, Hh - 1));
+        const float3 cq = srcTex.Load(int3(q, 0)).rgb;
+        const float w = exp(-dot(abs(cq - c0), float3(1, 1, 1)) * 5.0) * exp(-(float)(ax * ax + ay * ay) / 20.0);
