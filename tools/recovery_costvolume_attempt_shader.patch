+    const float tx = 1.0 / max(g_coarseW, 1.0);
+    const float uniqL = saturate((secondL - bestL) / (secondL + 1e-3) * 5.0);
+    const float uniqR = saturate((secondR - bestR) / (secondR + 1e-3) * 5.0);
+    return float4((float)(bkL * kStep) * tx, (float)(bkR * kStep) * tx, uniqL, uniqR);
