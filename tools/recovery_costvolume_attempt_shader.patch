+// Coarse disparity search (1/16), in two passes.
+//
+// The candidates are whole coarse pixels, +-g_dispMaxUV of the width (the
+// finer passes refine them) -- counted in pixels of THIS level, so the
+// search is the same whatever size or position the picture has on screen.
+// Up to 15 each way; a wider range steps 2 (3, ...) pixels at a time.
+void coarseRange(out int Kn, out int kStep)
+{
+    const int K = (int)ceil(g_dispMaxUV * g_coarseW);
+    kStep = max(1, (K + 14) / 15);
+    Kn = min(15, (K + kStep - 1) / kStep);
+}
+
+// Pass 1 -- matching cost of every candidate, once per pixel: 32 slots in 8
+// targets (slot j = candidate j - 15). g_propStride picks the direction:
+// 0 = dLR (this pixel's left view vs the right view there), 1 = dRL.
+struct CostOut
+{
+    float4 c0 : SV_Target0; float4 c1 : SV_Target1; float4 c2 : SV_Target2; float4 c3 : SV_Target3;
+    float4 c4 : SV_Target4; float4 c5 : SV_Target5; float4 c6 : SV_Target6; float4 c7 : SV_Target7;
+};
+CostOut PSAnaCost(VSOut i)
+{
+    const int2 p = int2(i.pos.xy);
+    const int W = (int)g_coarseW;
+    int Kn, kStep; coarseRange(Kn, kStep);
+    const bool dirR = g_propStride > 0.5;
+    float ref[16];
+    if (dirR) loadDescR(p, ref); else loadDescL(p, ref);
+    float c[32];
+    [unroll] for (int j = 0; j < 32; ++j)
+    {
+        const int k = j - 15;
+        c[j] = 10.0;   // (unused slot)
+        // (A candidate off the picture costs the most: comparing against the
+        // repeated edge pixel could look like a match, and every pixel near
+        // the edge then borrowed that one column -- streaks.)
+        [branch] if (abs(k) <= Kn && p.x + k * kStep >= 0 && p.x + k * kStep < W)
+        {
+            const int2 at = int2(clamp(p.x + k * kStep, 0, W - 1), p.y);
+            float cand[16];
+            if (dirR) loadDescL(at, cand); else loadDescR(at, cand);
+            c[j] = descCost(ref, cand);
+        }
+    }
+    CostOut o;
+    o.c0 = float4(c[0],  c[1],  c[2],  c[3]);  o.c1 = float4(c[4],  c[5],  c[6],  c[7]);
+    o.c2 = float4(c[8],  c[9],  c[10], c[11]); o.c3 = float4(c[12], c[13], c[14], c[15]);
+    o.c4 = float4(c[16], c[17], c[18], c[19]); o.c5 = float4(c[20], c[21], c[22], c[23]);
+    o.c6 = float4(c[24], c[25], c[26], c[27]); o.c7 = float4(c[28], c[29], c[30], c[31]);
+    return o;
+}
