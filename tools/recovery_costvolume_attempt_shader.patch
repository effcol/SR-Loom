+            const float cL = sL[j / 4][j % 4] / wsum + bias;
+            const float cR = sR[j / 4][j % 4] / wsum + bias;
+            if (cL < bestL) { if (abs(k - bkL) > 1) secondL = bestL; bestL = cL; bkL = k; }
+            else if (cL < secondL && abs(k - bkL) > 1) secondL = cL;
+            if (cR < bestR) { if (abs(k - bkR) > 1) secondR = bestR; bestR = cR; bkR = k; }
