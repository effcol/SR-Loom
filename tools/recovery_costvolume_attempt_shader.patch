+    float bestL = 1e9, secondL = 1e9; int bkL = 0;
+    float bestR = 1e9, secondR = 1e9; int bkR = 0;
+    [unroll] for (int j = 0; j < 32; ++j)
+    {
+        const int k = j - 15;
+        [branch] if (abs(k) <= Kn)
